{
  "authorized_scope_ack": true,
  "max_hosts": 2048,
  "tcp_concurrency": 100,
  "tcp_requests_per_second": 40,
  "verify_concurrency": 100,
  "verify_requests_per_second": 40,
  "queue_size": 1000,
  "connect_timeout_seconds": 1.5,
  "request_timeout_seconds": 4,
  "verify_url": "https://api.ipify.org?format=json",
  "history_limit": 30,
  "successes_per_endpoint": 1,
  "retry_failed_protocols": false,
  "verification_hard_timeout_seconds": 8
}
